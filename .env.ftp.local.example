# Copia a .env.ftp.local (no se sube a Git) y completa tus datos de cPanel.
# Uso: php scripts/deploy_ftp_local.php
#      php scripts/deploy_ftp_local.php --dry-run

FTP_HOST=ftp.laestaciondeldominohoy.com
FTP_PORT=21
FTP_USER=github_fvd@laestaciondeldominohoy.com
FTP_PASS=

# Ruta remota relativa a la raíz de la cuenta FTP:
#   ./  → la cuenta ya abre en public_html/mistorneos_fvd
#   public_html/mistorneos_fvd/  → cuenta en la raíz del hosting
FTP_REMOTE_DIR=./

# 1 = modo pasivo (recomendado en cPanel)
FTP_PASSIVE=1
