# =============================================================================
# PRODUCCIÓN — laestaciondeldominohoy.com
# Carpeta en servidor: public_html/mistorneos_fvd/
# =============================================================================
# 1. Copiar este archivo a la raíz del servidor como:  .env
# 2. Completar contraseñas y claves (NO subir .env a GitHub).
# 3. URL de acceso: https://laestaciondeldominohoy.com/mistorneos_fvd/public/

APP_ENV=production
APP_DEBUG=false
APP_URL=https://laestaciondeldominohoy.com/mistorneos_fvd
BASE_PATH=/mistorneos_fvd/public/
FORCE_HTTPS=true

# Base de datos principal (torneos, usuarios, inscritos)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mistorneos_fvd
DB_USERNAME=TU_USUARIO_CPANEL
DB_PASSWORD="TU_PASSWORD_BD"

# Base de datos secundaria (personas / fvdadmin) — opcional
DB_SECONDARY_HOST=localhost
DB_SECONDARY_PORT=3306
DB_SECONDARY_DATABASE=laestaci1_fvdadmin
DB_SECONDARY_USERNAME=TU_USUARIO_CPANEL
DB_SECONDARY_PASSWORD="TU_PASSWORD_BD"

# Sesión (recomendado en producción con www y sin www)
SESSION_NAME=mistorneos_fvd_session
SESSION_COOKIE_DOMAIN=.laestaciondeldominohoy.com
SESSION_GC_MAXLIFETIME=28800
SESSION_COOKIE_LIFETIME=28800

# Seguridad — generar valores aleatorios únicos
CSRF_KEY=GENERAR_32_CARACTERES_ALEATORIOS
APP_KEY=GENERAR_64_CARACTERES_ALEATORIOS

# Correo (opcional)
MAIL_HOST=mail.laestaciondeldominohoy.com
MAIL_PORT=587
MAIL_USERNAME=noreply@laestaciondeldominohoy.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@laestaciondeldominohoy.com
MAIL_FROM_NAME=Federación Venezolana de Dominó

LOG_LEVEL=error
