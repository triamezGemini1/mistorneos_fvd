# MisTorneos FVD — raíz del proyecto (public_html/mistorneos_fvd/)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /mistorneos_fvd/

    RewriteRule ^\.env - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^scripts/ - [F,L]

    RewriteCond %{REQUEST_URI} !^/mistorneos_fvd/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
