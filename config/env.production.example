# =============================================================================
# PRODUCCIÓN FVD — instalación STANDALONE (mistorneos_fvd original)
# Copiar a la raíz del proyecto como .env
# URL típica: https://tudominio.com/mistorneos_fvd/public/index.php
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://laestaciondeldominohoy.com/mistorneos_fvd
BASE_PATH=/mistorneos_fvd/public/
# NO definir INTEGRAL_WEB_ROOT en standalone (solo monorepo integral_fvd / mistorneos_fvd1)
# Si la app está en public_html/mistorneos_fvd/public/ deje INTEGRAL_WEB_ROOT sin definir.
# BASE_PATH debe ser exactamente: /mistorneos_fvd/public/
# INTEGRAL_WEB_ROOT=
FORCE_HTTPS=true

# Modo restringido (false por defecto): apaga administración FVD (afiliación, finanzas, portal).
# Gestión de torneos (torneo_gestion) permanece completa: rondas, mesas, inscripción en sitio, actas, etc.
# Apaga inscripción pública en línea (landing) y formularios de afiliación.
# true = reactivar todos los módulos FVD.
FVD_ADMIN_ENABLED=false

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mistorneos_fvd
DB_USERNAME=TU_USUARIO_CPANEL
DB_PASSWORD="TU_PASSWORD_BD"

DB_SECONDARY_HOST=localhost
DB_SECONDARY_PORT=3306
DB_SECONDARY_DATABASE=laestaci1_fvdadmin
DB_SECONDARY_USERNAME=TU_USUARIO_CPANEL
DB_SECONDARY_PASSWORD="TU_PASSWORD_BD"

SESSION_NAME=mistorneos_fvd_session
SESSION_COOKIE_DOMAIN=.laestaciondeldominohoy.com

CSRF_KEY=GENERAR_32_CARACTERES_ALEATORIOS
APP_KEY=GENERAR_64_CARACTERES_ALEATORIOS

# --- Solo si usa monorepo mistorneos_fvd1 (NO es el caso habitual) ---
# APP_URL=https://tudominio.com/mistorneos_fvd1/mistorneos_fvd
# BASE_PATH=/mistorneos_fvd1/mistorneos_fvd/public/
# INTEGRAL_WEB_ROOT=mistorneos_fvd1
